{
  "description": "Context Ledger local checkpoints and bounded recovery.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/skills/context-ledger/scripts/ledger.py\" --host codex hook",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/skills/context-ledger/scripts/ledger.py\" --host codex hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/skills/context-ledger/scripts/ledger.py\" --host codex hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/skills/context-ledger/scripts/ledger.py\" --host codex hook",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/skills/context-ledger/scripts/ledger.py\" --host codex hook",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/skills/context-ledger/scripts/ledger.py\" --host codex hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
